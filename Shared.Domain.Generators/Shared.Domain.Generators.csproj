<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Roslyn loads analyzers and generators into the compiler, which requires netstandard2.0 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <!--
      Ex0100: an exception escaping a generator surfaces as a compiler warning naming the
              generator, so documenting every Roslyn API that can throw adds nothing.
      RS2008: release tracking is for analyzers shipped as packages, this one is only
              referenced from inside the solution.
    -->
    <NoWarn>$(NoWarn),Ex0100,RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
